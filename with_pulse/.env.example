# Claude API
ANTHROPIC_API_KEY=
# Only needed when the API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Yanez Pulse. Values below point at the Production environment.
# Agent key (starts with yak_) created in the YID app. Keep it secret.
YANEZ_AGENT_API_KEY=
YANEZ_BASE_URL=https://yid.yanez.ai
YANEZ_EXPECTED_ISSUER=https://yid.yanez.ai
# Your YID, shown in the YID app under Settings. Checkout only accepts approvals from it.
YANEZ_EXPECTED_YID=
